# Arquivo de exemplo. Copie para .env (cp .env.example .env) e preencha.
# Nunca envie o .env para o GitHub: ele já está no .gitignore.

# PostgreSQL (Neon): conexão com pool para a aplicação e direta para migrações.
# Substitua pelas duas URLs do MESMO banco/branch no painel do Neon.
# Não use estas credenciais de exemplo. Veja VERCEL.md.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-SEU-ENDPOINT-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&connection_limit=1"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-SEU-ENDPOINT.sa-east-1.aws.neon.tech/neondb?sslmode=require"


# Fuso usado pelo servidor, inclusive no ambiente Vercel.
TZ="America/Sao_Paulo"

# Arquivos no disco. No Coolify, configure também um volume persistente
# com Destination Path igual a este caminho dentro do container.
# Sem esta variável, usa a pasta storage dentro do diretório da aplicação.
# STORAGE_DIR="/app/storage"

# Chave que assina o cookie de sessão (login). Mínimo de 32 caracteres, recomendado 64.
# Gere uma chave aleatória no terminal com:
#   openssl rand -base64 48
# Se trocar esta chave, todo mundo precisa entrar de novo.
SESSION_SECRET="cole-aqui-a-chave-gerada-pelo-openssl"

# E-mail do administrador criado pelo seed de demonstração (npm run db:seed).
# Use um endereço terminado em @demanda.local: o sistema trata esses e-mails como contas de exemplo
# e permite desativá-las no primeiro acesso.
SEED_ADMIN_EMAIL="admin@demanda.local"

# Senha das contas de demonstração criadas pelo seed (mínimo de 8 caracteres).
# Todas as pessoas de exemplo usam a mesma senha. Gere uma com:
#   openssl rand -base64 12
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Opcionais, só para o teste automático de ponta a ponta (scripts/e2e/simulacao.ts).
# Endereço onde o sistema está rodando durante o teste.
# E2E_BASE="http://localhost:3000"
# Pasta onde o teste salva as capturas de tela.
# E2E_SHOTS="/tmp/dmanda-e2e"
# Caminho do Google Chrome usado pelo teste (o padrão é o do Mac).
# E2E_CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# NODE_ENV é definido sozinho pelo Next.js (development no "npm run dev", production no "npm run build/start").
# Não precisa colocar aqui.

# Trello: captura local de leitura para a migração (anexos e histórico).
# Gere a chave no Trello e autorize um token de usuário com escopo read.
# Use o token do Trello associado à chave, não um token genérico da conta Atlassian.
# Preencha diretamente neste arquivo; estas variáveis são exclusivas do servidor/CLI.
TRELLO_API_KEY=""
TRELLO_API_TOKEN=""
